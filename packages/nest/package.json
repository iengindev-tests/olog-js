{
  "name": "@olog-js/nest",
  "version": "1.1.0",
  "description": "NestJS integration for olog-js: module, LoggerService adapter and HTTP request logging",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "watch": "tsdown --watch",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "log",
    "logger",
    "logging",
    "typescript",
    "nest",
    "nestjs"
  ],
  "author": "iengindev",
  "license": "MIT",
  "packageManager": "pnpm@10.30.1",
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@olog-js/core": "workspace:^"
  },
  "devDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@olog-js/core": "workspace:*",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iengindev/olog-js.git",
    "directory": "packages/nest"
  },
  "homepage": "https://github.com/iengindev/olog-js#readme",
  "bugs": "https://github.com/iengindev/olog-js/issues",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
