{
  "name": "@olog-js/file-transport",
  "version": "1.0.0",
  "description": "Zero-dependency, type-safe logger core for every JavaScript runtime",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "watch": "tsdown --watch",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "log",
    "logger",
    "logging",
    "typescript"
  ],
  "author": "iengindev",
  "license": "MIT",
  "packageManager": "pnpm@10.30.1",
  "peerDependencies": {
    "@olog-js/core": "workspace:^"
  },
  "devDependencies": {
    "@olog-js/core": "workspace:*",
    "@types/node": "^26.6.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iengindev/olog-js.git",
    "directory": "packages/transports/file-transport"
  },
  "homepage": "https://github.com/iengindev/olog-js#readme",
  "bugs": "https://github.com/iengindev/olog-js/issues",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
